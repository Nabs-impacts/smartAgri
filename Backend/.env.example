APP_ENV=local
APP_NAME=SmartAgri API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO
SENTRY_DSN=
POSTGRES_USER=smartagri
POSTGRES_PASSWORD=smartagri
POSTGRES_DB=smartagri
DATABASE_URL=postgresql+asyncpg://smartagri:smartagri@localhost:5432/smartagri
DATABASE_URL_SYNC=postgresql+psycopg://smartagri:smartagri@localhost:5432/smartagri
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
JWT_SECRET=dev-jwt-secret-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_HMAC_SECRET=dev-otp-hmac-secret-min-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_WINDOW=3
OTP_WINDOW_SECONDS=600
API_KEY_PEPPER=dev-api-key-pepper-min-32-chars
LICENSE_KEY_PEPPER=dev-license-key-pepper-min-32-chars
LICENSE_TOKEN_SECRET=dev-license-token-secret-min-32-chars
S3_ENDPOINT_URL=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=smartagri-media
S3_PRESIGN_UPLOAD_SECONDS=600
S3_PRESIGN_READ_SECONDS=600
MAX_IMAGE_BYTES=3145728
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_SECONDS=15
MAX_AUDIO_BYTES=2097152
MAX_AUDIO_SECONDS=60
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime
ALLOWED_AUDIO_MIME=audio/mpeg,audio/wav,audio/ogg,audio/mp4,audio/aac
INFERENCE_MODE=stub
MODEL_CACHE_DIR=/tmp/smartagri_models
DIAGNOSTIC_CONFIDENCE_THRESHOLD=0.70
OUTBREAK_MIN_CONFIDENCE=0.50
OUTBREAK_ALERT_THRESHOLD=5
OUTBREAK_ALERT_WINDOW_DAYS=7
KEYFRAME_COUNT=5
SMS_PROVIDER=fake
SMS_HTTP_URL=
SMS_HTTP_KEY=
PUSH_PROVIDER=fake
FCM_CREDENTIALS_PATH=
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_PROVIDER=fake
EMBEDDING_HTTP_URL=
EMBEDDING_HTTP_KEY=
EMBEDDING_DIM=1024
WEATHER_PROVIDER=fake
SATELLITE_PROVIDER=fake
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
PAYMENT_PROVIDER_MODE=fake
PAYMENT_AGGREGATOR_BASE_URL=http://localhost:8000/fake-aggregator
PAYMENT_AGGREGATOR_API_KEY=fake-api-key
PAYMENT_AGGREGATOR_WEBHOOK_SECRET=fake-webhook-secret
PAYMENT_PENDING_TIMEOUT_MINUTES=30
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=3
DATA_EXPORT_URL_SECONDS=86400
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
